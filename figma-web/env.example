# From `npx convex dev` in this folder. Use a new Convex project.
VITE_CONVEX_URL=

# Apify Console → Settings → API tokens. Starts one actor run per scan. Not shown on screen.
VITE_APIFY_TOKEN=

# Server-only keys. Put these in figma-web/.env.local (that file stays off git).
# Do not prefix them with VITE_. Restart `npm run dev` after saving.
# Anthropic: console.anthropic.com → API keys. Powers "Get fit guidance".
ANTHROPIC_API_KEY=
# Cartesia: play.cartesia.ai/keys. Speaks the scan instructions.
CARTESIA_API_KEY=
